<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/thongtin_2108"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập thông tin"
            android:layout_marginBottom="12dp"
            android:textStyle="bold">
        </TextView>
    <TextView
            android:id="@+id/manhanvien_2108"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên: "
            android:textStyle="bold" >

        </TextView>
    <EditText
        android:id="@+id/edtmanhanvien_2108"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mã nhân viên "
        android:minHeight="48dp"
        android:layout_marginTop="12dp"
        android:inputType="text">
    </EditText>
    <TextView
            android:id="@+id/sogio_2108"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số giờ: "
            android:textStyle="bold" >

        </TextView>
    <EditText
        android:id="@+id/edtsogio_2108"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số giờ "
        android:minHeight="48dp"
        android:layout_marginTop="12dp"
        android:inputType="text">
    </EditText>
    <TextView
            android:id="@+id/tiencong_2108"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiền công: "
            android:textStyle="bold" >

        </TextView>
    <EditText
        android:id="@+id/edttiencong_2108"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tiền công "
        android:minHeight="48dp"
        android:layout_marginTop="12dp"
        android:inputType="text">
    </EditText>
    <TextView
        android:id="@+id/ketqua2108"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kết quả: "
        android:textStyle="bold" >
    </TextView>
    <Button
        android:id="@+id/btnthem_2108"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm ca">
    </Button>
    <Button
        android:id="@+id/btnxoa_2108"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xóa dữ liệu">
    </Button>
</LinearLayout>